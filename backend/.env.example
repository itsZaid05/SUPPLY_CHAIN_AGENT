# FastAPI Configuration
APP_NAME="Sentinel Supply Chain Agent"
APP_VERSION="2.0.0"
DEBUG=False
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# Gemini API
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-pro"

# Firebase (Optional - if not set, uses in-memory storage)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CREDENTIALS_PATH="./firebase-credentials.json"
FIRESTORE_USE_EMULATOR=False
FIRESTORE_EMULATOR_HOST="localhost:8080"

# External APIs
# Both are OPTIONAL — system falls back to mock data with a [FALLBACK] badge if absent.
# NewsAPI: free tier at https://newsapi.org — provides live shipping/port headlines per hub.
# StormGlass: free tier at https://stormglass.io — provides live wind/wave/precip per lat/lon.
NEWSAPI_KEY="your-newsapi-key"
STORMGLASS_KEY="your-stormglass-key"

# Optimization Engine Weights
WEIGHT_FREIGHT_COST=0.25
WEIGHT_PENALTY_SLA=0.25
WEIGHT_RISK_PHYSICAL=0.35
WEIGHT_IMPACT_CARBON=0.15

# Node Capacity Configuration
CAPACITY_THRESHOLD=0.80
EXPONENTIAL_PENALTY_FACTOR=2.5

# Cost Parameters
FUEL_COST_PER_NM=0.82
DELAY_PENALTY_PER_HOUR=14000
CARBON_COST_PER_TONNE=5000
