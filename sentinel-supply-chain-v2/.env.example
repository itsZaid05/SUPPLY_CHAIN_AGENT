# FastAPI backend URL (frontend reads this)
NEXT_PUBLIC_FASTAPI_BASE_URL=http://localhost:8000

# Gemini AI (optional — heuristic fallback active without it)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# News API (optional — keyword fallback active without it)
NEWSAPI_KEY=your_newsapi_key_here

# StormGlass weather (optional — baseline model active without it)
STORMGLASS_KEY=your_stormglass_key_here

# Firebase Firestore (optional — real-time sync disabled without it)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVICE_ACCOUNT_JSON=path/to/service-account.json
FIREBASE_WORLD_STATE_DOC_PATH=worldState/live

# CORS (comma-separated)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
